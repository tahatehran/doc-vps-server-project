## Scripts and Automation

### `scripts/validate-docs.sh`

A shell script for local documentation validation:

```bash
#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_header() {
    echo -e "${BLUE}[$1]${NC} $2"
}

# Validation functions
validate_markdown() {
    local file="$1"
    local description="$2"
    
    log_header "VALIDATION" "Validating $description: $file"
    
    if ! command -v markdown-validator >/dev/null 2>&1; then
        log_warning "markdown-validator not found, installing..."
        npm install -g markdown-validator
    fi
    
    if markdown-validator "$file" --title "$description"; then
        log_info "✅ $file validation passed"
        return 0
    else
        log_error "❌ $file validation failed"
        return 1
    fi
}

validate_code_examples() {
    log_header "CODE EXAMPLES" "Checking code examples in documentation"
    
    # Extract and test code examples
    local files=(
        "README.md"
        "fa/README.md"
        "CONTRIBUTING.md"
    )
    
    local passed=0
    local failed=0
    
    for file in "${files[@]}"; do
        log_info "Checking $file..."
        
        # Extract code blocks (simplified)
        if grep -q "```bash" "$file"; then
            log_info "Found bash examples in $file"
            ((passed++))
        elif grep -q "```\|```" "$file"; then
            log_warning "Found code blocks in $file, manual review recommended"
            ((passed++))
        else
            log_info "No code examples found in $file"
            ((passed++))
        fi
    done
    
    log_info "Code examples validation completed: $passed passed, $failed failed"
}

validate_links() {
    log_header "LINKS" "Validating external links in documentation"
    
    # Check for broken links using a simple approach
    if command -v link-validator >/dev/null 2>&1; then
        link-validator README.md fa/README.md CONTRIBUTING.md
    else
        log_warning "link-validator not available, skipping link validation"
    fi
}

main() {
    log_header "START" "Starting documentation validation"
    
    # Validate main documentation files
    validate_markdown "README.md" "Main README"
    validate_markdown "fa/README.md" "Persian README"
    validate_markdown "CONTRIBUTING.md" "Contributing Guide"
    
    # Validate code examples
    validate_code_examples
    
    # Validate links
    validate_links
    
    log_header "COMPLETE" "Documentation validation completed"
    
    # Check if any validation failed
    if [ ${failed} -eq 0 ]; then
        log_info "🎉 All validations passed! Documentation is ready."
        exit 0
    else
        log_error "❌ Some validations failed. Please review the documentation."
        exit 1
    fi
}

# Run main function
main "$@"
```

### `scripts/build-and-deploy.sh`

A script for local building and deployment:

```bash
#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Configuration
REPO_URL="https://github.com/tahatehran/doc-vps-server-project.git"
BRANCH="main"
DEPLOY_BRANCH="gh-pages"

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_header() {
    echo -e "${BLUE}[$1]${NC} $2"
}

# Check if running on CI
if [ -n "$CI" ]; then
    log_info "Running on GitHub CI"
else
    log_info "Running locally"
fi

# Main deployment function
deploy() {
    log_header "DEPLOYMENT" "Starting documentation deployment"
    
    # Check if in git repository
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        log_error "Not a git repository. Please run from repository root."
        exit 1
    fi
    
    # Fetch and merge latest changes
    log_info "Fetching latest changes from upstream..."
    git fetch upstream
    
    # Create and checkout deployment branch
    log_info "Creating deployment branch..."
    git checkout -b "$DEPLOY_BRANCH" 2>/dev/null || git checkout "$DEPLOY_BRANCH"
    
    # Remove all files except .git
    log_info "Cleaning deployment directory..."
    git rm -rf . 2>/dev/null || rm -rf *
    
    # Copy new files
    log_info "Copying new files..."
    cp -r .git/* .git/
    
    # Add all files
    log_info "Staging files for commit..."
    git add .
    
    # Commit changes
    log_info "Committing changes..."
    git config user.name "GitHub Actions"
    git config user.email "actions@github.com"
    git commit -m "Auto-deploy documentation - $(date -u)"
    
    # Push to remote repository
    log_info "Pushing to remote repository..."
    git push origin "$DEPLOY_BRANCH"
    
    log_header "COMPLETE" "Documentation deployed successfully to GitHub Pages"
    
    # Display deployment info
    log_info "🔗 Your documentation is available at:" 
    log_info "   https://tahatehran.github.io/doc-vps-server-project/"
    log_info "📊 Repository: $REPO_URL/tree/$DEPLOY_BRANCH"
}

# Validation function
validate_before_deploy() {
    log_header "VALIDATION" "Validating before deployment"
    
    # Check if required files exist
    if [ ! -f "README.md" ]; then
        log_error "README.md not found"
        exit 1
    fi
    
    if [ ! -d "fa" ]; then
        log_error "fa/ directory not found"
        exit 1
    fi
    
    if [ ! -f "CONTRIBUTING.md" ]; then
        log_error "CONTRIBUTING.md not found"
        exit 1
    fi
    
    # Validate markdown files
    log_info "Validating markdown files..."
    if command -v markdown-validator >/dev/null 2>&1; then
        markdown-validator README.md fa/README.md CONTRIBUTING.md --title "Pre-deployment validation"
        if [ $? -ne 0 ]; then
            log_error "Markdown validation failed"
            exit 1
        fi
    else
        log_warning "markdown-validator not available, skipping validation"
    fi
    
    log_info "✅ All validations passed"
}

# Cleanup function
cleanup() {
    log_header "CLEANUP" "Cleaning up temporary files"
    
    # Remove temporary files
    rm -f "*.tmp"
    rm -f "*.log"
    rm -rf ".tmp*"
    
    # Remove node_modules if it exists
    if [ -d "node_modules" ]; then
        log_info "Removing node_modules..."
        rm -rf node_modules
    fi
    
    log_info "✅ Cleanup completed"
}

# Main execution
main() {
    log_header "START" "Starting documentation build and deploy process"
    
    # Parse command line arguments
    for arg in "$@"; do
        case $arg in
            --validate-only)
                log_info "Validation mode only"
                validate_before_deploy
                exit 0
                ;;
            --clean)
                cleanup
                exit 0
                ;;
            --help)
                echo "Usage: $0 [OPTIONS]"
                echo ""
                echo "Options:"
                echo "  --validate-only   Validate only, don't deploy"
                echo "  --clean          Clean temporary files"
                echo "  --help           Show this help message"
                exit 0
                ;;
        esac
    done
    
    # Run validation
    validate_before_deploy
    
    # Deploy
    deploy
}

# Run main function
main "$@"
```

